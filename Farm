-- Make Button Draggable for Mobile Users
local dragging, dragInput, dragStart, startPos

local function updateInput(input)
    local delta = input.Position - dragStart
    ToggleButton.Position = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
end

ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

ToggleButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateInput(input)
    end
end)

-- 1-Second Refresh Task to cache mob instances
task.spawn(function()
    while true do
        if isAttacking then
            currentMobInstances = MobsFolder:GetChildren()
        end
        task.wait(1)
    end
end)

-- Continuous Hit Loop (Filters by distance in real-time)
task.spawn(function()
    while true do
        if isAttacking and #currentMobInstances > 0 then
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")

            if rootPart then
                local playerPos = rootPart.Position
                local nearbyEntityIds = {}

                for _, mob in ipairs(currentMobInstances) do
                    if mob and mob.Parent then
                        local entityId = mob:GetAttribute("EntityId")
                        local mobPos = getMobPosition(mob)

                        if entityId and mobPos then
                            local distance = (playerPos - mobPos).Magnitude
                            if distance <= MAX_DISTANCE then
                                table.insert(nearbyEntityIds, entityId)
                            end
                        end
                    end
                end

                -- Fire server only if there are valid mobs within distance
                if #nearbyEntityIds > 0 then
                    local args = {
                        nearbyEntityIds
                    }
                    RequestMeleeHits:FireServer(unpack(args))
                end
            end
        end
        RunService.RenderStepped:Wait()
    end
end)

-- Toggle Action
ToggleButton.MouseButton1Click:Connect(function()
    isAttacking = not isAttacking
    
    if isAttacking then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 220, 50)
        ToggleButton.Text = "AUTO HIT: ON"
        currentMobInstances = MobsFolder:GetChildren()
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        ToggleButton.Text = "AUTO HIT: OFF"
        currentMobInstances = {}
    end
end)
