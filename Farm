-- Configuration
local MAX_DISTANCE = 50 -- Distance in studs to target mobs

-- Services & Local Variables
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Combat = Remotes:WaitForChild("Combat")
local RequestMeleeHits = Combat:WaitForChild("RequestMeleeHits")
local MobsFolder = workspace:WaitForChild("Mobs"):WaitForChild("Active")

local isAttacking = false
local currentMobList = {}

-- Helper function to extract EntityIds of mobs within range
local function fetchNearbyEntityIds()
    local ids = {}
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return ids
    end

    local playerPosition = character.HumanoidRootPart.Position

    for _, mob in ipairs(MobsFolder:GetChildren()) do
        local entityId = mob:GetAttribute("EntityId")
        
        -- Get position (works for Models and BaseParts)
        local mobPosition
        if mob:IsA("Model") then
            mobPosition = mob:GetPivot().Position
        elseif mob:IsA("BasePart") then
            mobPosition = mob.Position
        end

        if entityId and mobPosition then
            local distance = (playerPosition - mobPosition).Magnitude
            if distance <= MAX_DISTANCE then
                table.insert(ids, entityId)
            end
        end
    end
    return ids
end

